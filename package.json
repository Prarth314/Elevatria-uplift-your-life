{
  "name": "elevatria-uplift-your-life",
  "type": "module",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "node scripts/frontend.mjs dev",
    "build": "node scripts/frontend.mjs build",
    "preview": "node scripts/frontend.mjs preview",
    "typecheck": "node scripts/frontend.mjs typecheck && npm run typecheck:server",
    "test": "node --test tests/*.test.ts",
    "audit": "node scripts/audit-source.mjs",
    "dev:api": "node scripts/api-server.mjs",
    "typecheck:server": "node src/frontend/node_modules/typescript/bin/tsc -p tsconfig.server.json --noEmit",
    "benchmark": "node scripts/benchmark-scheduler.ts"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "sharp": "^0.35.5"
  },
  "private": true,
  "packageManager": "pnpm@11.25.0"
}
