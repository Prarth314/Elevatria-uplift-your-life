# Milestone 1 runs without environment variables or external services.
# Optional legacy Calendar prototype (public OAuth client ID, never a secret).
# VITE_GOOGLE_CLIENT_ID=your-public-google-oauth-client-id
# Reserved for a FUTURE server implementation; never use a VITE_ prefix for secrets.
# OPENAI_API_KEY=server-only-placeholder

# Optional account storage. Leave ALL these values unset for the local demo.
# Read docs/CLOUD_SETUP.md before configuring; no paid plan is required.
# Browser-visible public configuration (never a secret/service-role key):
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=your-public-publishable-key
# Server-only configuration; use .env locally or Vercel server environment variables:
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=your-public-publishable-key
# SUPABASE_SECRET_KEY=your-server-only-secret-key

# Legacy anon-key alternative (use instead of the publishable-key names above):
# VITE_SUPABASE_ANON_KEY=your-public-anon-key
# SUPABASE_ANON_KEY=your-public-anon-key
# Legacy server-only alternative to SUPABASE_SECRET_KEY:
# SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
# Google OAuth client ID/secret are configured in Supabase, not VITE_ variables.
