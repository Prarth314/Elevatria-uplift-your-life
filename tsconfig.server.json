{
  "compilerOptions": {
    "target": "ESNext", "module": "ESNext", "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM"], "strict": true, "skipLibCheck": true,
    "allowImportingTsExtensions": true, "noEmit": true,
    "typeRoots": ["./src/frontend/node_modules/@types"], "types": ["node"]
  },
  "include": ["api/**/*.ts", "src/server/**/*.ts"]
}
